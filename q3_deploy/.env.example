# Copy to .env (cp .env.example .env). .env must NEVER be committed.
# These are placeholders for a local stack. Change MONGO_PASSWORD for anything shared.

# MongoDB root account. The mongo service creates it the first time its volume
# is initialized; changing it later needs `docker compose down -v` (deletes data).
# Use letters and digits only: the API puts both values in its connection URL.
MONGO_USER=idv_admin
MONGO_PASSWORD=change-me-local-only
MONGO_DB=identity_verification

# Service addresses on the Compose network.
OCR_URL=http://mock_ocr:9100/ocr/parse
ONBOARDING_URL=http://mock_onboarding:9200/ingest

# CSV imported at startup as the seed batch. A restart finds it by the file's
# hash and does not import it again. Leave empty to skip seeding.
SEED_CSV=/srv/data/account_applications.csv
